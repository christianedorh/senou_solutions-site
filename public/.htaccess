# SENOU Solutions — configuration Apache (PlanetHoster)
# Site statique généré par `npm run build` (dossier out/), à placer à la racine de public_html.

Options -Indexes -MultiViews
DirectoryIndex index.html
# Chaque page existe en « page.html » ET en dossier « page/ » (données de navigation Next.js) :
# on empêche Apache d'ajouter un « / » final pour que /contact serve contact.html.
DirectorySlash Off
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # HTTPS obligatoire, sans « www »
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # /page/ → /page
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # /en → en.html (le dossier en/ existe aussi)
  RewriteRule ^en$ en.html [L]

  # URL propres : /contact → contact.html
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType application/manifest+json .webmanifest
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json image/svg+xml application/xml
</IfModule>

# Cache navigateur : fichiers versionnés de Next.js pour 1 an, médias 30 jours, HTML toujours revalidé
<IfModule mod_headers.c>
  <FilesMatch "\.(html|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|webp|avif|svg|ico|mp4|webm|pdf|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
